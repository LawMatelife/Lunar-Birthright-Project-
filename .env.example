# Lunar Birthright V4 — example values only.
# Never place real credentials in this file or commit them to GitHub.

# Core database runtime (required only after the authoritative-registry recovery gate)
DB_NAME=lunar_birthright
MONGO_URL=mongodb+srv://<app-user>:<url-encoded-password>@<cluster-host>/lunar_birthright?retryWrites=true&w=majority&appName=LunarBirthright

# Owner-only admin authentication. Use a strong random value for the session
# secret and an email address controlled by the project owner. OTP delivery uses
# Resend; do not commit any real values.
ADMIN_EMAIL=<owner-admin-email>
ADMIN_SESSION_SECRET=<at-least-32-random-characters>
ADMIN_FROM_EMAIL=<verified-sender@example.com>
RESEND_API_KEY=<resend-production-api-key>

# Public Stripe Payment Link targets. These are not secrets and can be overridden
# per environment without modifying source.
LUNAR_GIFT_CHECKOUT_URL=https://buy.stripe.com/28E4gA6zBfTIdQe5GC93y04
LUNAR_UPGRADE_CHECKOUT_URL=https://buy.stripe.com/bJe7sMgab6j84fEglg93y03

# Payment / minting runtime. Configure these secrets only after recovery, Atlas,
# health, admin and functional gates are green.
STRIPE_SECRET_KEY=<stripe-live-secret>
STRIPE_WEBHOOK_SECRET=<lunar-webhook-signing-secret>
CROSSMINT_API_KEY=<crossmint-production-api-key>

# Public application URL. Set to the isolated Lunar preview during testing and
# the custom domain only after the final cutover gate has passed.
APP_BASE_URL=https://<isolated-lunar-deployment-host>
