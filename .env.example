# Lunar Birthright V4 — example values only.
# Never place real credentials in this file or commit them to GitHub.

# Core database runtime (required before Atlas health can pass)
DB_NAME=lunar_birthright
MONGO_URL=mongodb+srv://<app-user>:<url-encoded-password>@<cluster-host>/lunar_birthright?retryWrites=true&w=majority&appName=LunarBirthright

# Payment / minting runtime (configure only when the Atlas/data gates are green)
STRIPE_SECRET_KEY=<stripe-live-secret>
STRIPE_WEBHOOK_SECRET=<stripe-webhook-signing-secret>
CROSSMINT_API_KEY=<crossmint-production-api-key>

# Public application URL. Set to the preview URL during testing and the custom
# domain only after the final cutover gate has passed.
APP_BASE_URL=https://<deployment-host>
