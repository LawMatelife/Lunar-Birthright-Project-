# Lunar Birthright V4 — example values only.
# Never place real credentials in this file or commit them to GitHub.

# Core database runtime. Configure only on the isolated Lunar deployment after
# the authoritative-registry recovery/reconciliation gate is complete.
DB_NAME=lunar_birthright
MONGO_URL=mongodb+srv://<app-user>:<url-encoded-password>@<cluster-host>/lunar_birthright?retryWrites=true&w=majority&appName=LunarBirthright

# Native V4 application authentication uses the existing user/admin records and
# HttpOnly session cookie. Do not create a parallel admin login system.
JWT_SECRET=<strong-random-native-v4-auth-secret>

# Certificate email delivery. A paid/granted certificate remains downloadable
# even when email delivery is temporarily unavailable.
RESEND_API_KEY=<resend-production-api-key>
SENDER_EMAIL=<verified-lunar-sender@example.com>

# Native Stripe checkout. The app creates its own Checkout Session plus pending
# certificate/payment record before sending the customer to Stripe.
STRIPE_SECRET_KEY=<stripe-live-secret>
STRIPE_WEBHOOK_SECRET=<dedicated-lunar-webhook-signing-secret>

# Polygon/Crossmint is deliberately a separate release gate. Both switches must
# be explicitly opened before the runtime is allowed to initiate a mint.
ENABLE_POLYGON_MINT=false
MINTING_RELEASE_GATE=closed
CROSSMINT_API_KEY=<crossmint-production-api-key>
CROSSMINT_COLLECTION_ID=<lunar-collection-id>
CROSSMINT_ENV=production

# Public application URL. Use the isolated Lunar preview during acceptance and
# the custom domain only after the final domain-cutover gate has passed.
FRONTEND_URL=https://<isolated-lunar-deployment-host>
APP_BASE_URL=https://<isolated-lunar-deployment-host>
